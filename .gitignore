# nodebench outputs. A real run's report carries a node label, a driver version,
# a card count and a timestamp -- together those identify a specific machine, so
# nothing from a real run belongs in the repository. Only examples/ is exempt,
# and everything in there is synthetic by construction.
nodebench_out/
run*/
results/
raw/
*.csv
*.html
!examples/*.html
!nodebench/report/templates/*.html
# docs/dashboard.html is the hand-written summary dashboard linked from docs/index.md.
# It is NOT a run report: it is self-contained, carries no machine label, no driver
# version, no timestamp and no hostname -- checked before adding this line. Without
# this exemption the global *.html rule swallows it silently, and the link on the
# published Pages site 404s. (Same failure shape as the `traces/` rule in prefixkv.)
!docs/dashboard.html

# native toolchain (cloned + built by `nodebench setup --native`)
third_party/
build/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
.pytest_cache/
.ruff_cache/

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# never commit private notes
NOTES.private.md
